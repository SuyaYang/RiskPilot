# PayPal Sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID as above; this one is sent to the browser for the JS SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: webhook ID from the Sandbox app's webhook settings (needs a public URL)
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Gemini (aistudio.google.com/apikey). If empty or failing, template explanations are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Plaid Sandbox (not required for the demo personas)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
