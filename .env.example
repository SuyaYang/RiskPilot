# Local fictional demo only. Production authentication/database are not implemented yet.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
# The independent merchant demo launcher overrides APP_ORIGIN to http://localhost:3100.
RISKPILOT_ORIGIN=http://localhost:3100
MERCHANT_ORIGIN=http://localhost:3200
MERCHANT_PORT=3200
# Optional server-only shared key (32+ chars). Local demo generates data/merchant-bridge.key if blank.
MERCHANT_BRIDGE_SECRET=
DEMO_SEED_ENABLED=true
# New format; preserve the old data/store.json rather than erasing payment facts.
STORE_PATH=./data/demo-v2.json
# Optional fixed UTC scenario date for recordings
DEMO_TODAY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Target architecture from README: reserved, not wired into this local demo yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
SUPABASE_SERVER_SECRET_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_API_BASE=https://sandbox.plaid.com
PLAID_WEBHOOK_URL=
ENGINE_BASE_URL=http://localhost:8000
ENGINE_SERVICE_TOKEN=
DATA_ENCRYPTION_KEY=
FORECAST_POLICY_VERSION=rp-v1
